# Fichier .gitignore pour un projet Django sur macOS

# ----------------- Fichiers générés par Django ------------------
*.log

/media/
/private_files/

# Fichiers de cache de Django
__pycache__/
*.pyc
*.pyd
*.pyo

# ------------------ Fichiers système de l'OS (macOS) ------------------
.DS_Store
.vscode/

# ------------------ Fichiers Python et dépendances ------------------
venv/
venv.txt
env/
.env
pip-log.txt
dist/
build/
*.egg-info/

# Fichiers de mot de passe et clés secrètes
.env
local_settings.py
settings_secret.py
secret.txt

# ---------------- Autres fichiers ------------------
# Si vous utilisez un IDE spécifique comme PyCharm
.idea/

# Fichiers de test coverage
.coverage
.tox/

# Fichiers de base de données temporaires
*.db
db.sqlite3
data_dump.json

text.txt
type_comment.py

requirementsystem.txt